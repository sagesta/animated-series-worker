{
  "schemaVersion": 1,
  "sourceRepository": "https://github.com/Lightricks/ComfyUI-LTXVideo.git",
  "sourceCommit": "15d09abb5a187a8dcaea2fc31fe51ee96e6c9d0d",
  "sourceWorkflow": "example_workflows/2.5/LTX-2.5_ICLoRA_Ingredients_Single_Stage_Distilled.json",
  "bindings": [
    {
      "classType": "LoadImage",
      "title": "LoadImage",
      "input": "image",
      "value": "$INPUT:0"
    },
    {
      "classType": "CLIPTextEncode",
      "title": "CLIP Text Encode (Positive Prompt)",
      "input": "text",
      "value": "$PARAM:motionPrompt"
    },
    {
      "classType": "ComfyMathExpression",
      "title": "calculate frames count - Math Expression",
      "input": "values.b",
      "value": "$PARAM:durationSeconds"
    },
    {
      "classType": "RandomNoise",
      "input": "noise_seed",
      "value": "$PARAM:seed"
    }
  ]
}
