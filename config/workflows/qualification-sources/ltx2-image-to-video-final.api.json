{
  "1": { "class_type": "LoadImage", "inputs": { "image": "$INPUT:0" } },
  "2": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["1", 0],
      "resize_type": "scale longer dimension",
      "resize_type.longer_size": 1536,
      "scale_method": "lanczos"
    }
  },
  "3": { "class_type": "LTXVPreprocess", "inputs": { "image": ["2", 0], "img_compression": 18 } },
  "4": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "5": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-bf16.safetensors",
      "type": "ltxv",
      "device": "default"
    }
  },
  "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "$PARAM:motionPrompt", "clip": ["5", 0] } },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "low quality, inconsistent character, distorted anatomy, flicker, text, watermark",
      "clip": ["5", 0]
    }
  },
  "8": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "frame_rate": "$PARAM:framesPerSecond"
    }
  },
  "9": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-video-vae-bf16.safetensors" } },
  "10": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-audio-vae-bf16.safetensors" } },
  "11": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "ceil((ceil(a * b) - 1) / 8) * 8 + 1",
      "values.a": "$PARAM:durationSeconds",
      "values.b": "$PARAM:framesPerSecond"
    }
  },
  "12": { "class_type": "ComfyMathExpression", "inputs": { "expression": "a / 2", "values.a": 1280 } },
  "13": { "class_type": "ComfyMathExpression", "inputs": { "expression": "a / 2", "values.a": 720 } },
  "14": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": ["12", 1],
      "height": ["13", 1],
      "length": ["11", 1],
      "batch_size": 1
    }
  },
  "15": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": ["9", 0],
      "image": ["3", 0],
      "latent": ["14", 0],
      "strength": 0.7,
      "bypass": false
    }
  },
  "16": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": ["11", 1],
      "frame_rate": "$PARAM:framesPerSecond",
      "batch_size": 1,
      "audio_vae": ["10", 0]
    }
  },
  "17": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["15", 0], "audio_latent": ["16", 0] } },
  "18": { "class_type": "RandomNoise", "inputs": { "noise_seed": "$PARAM:seed" } },
  "19": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler_ancestral" } },
  "20": {
    "class_type": "ManualSigmas",
    "inputs": { "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0" }
  },
  "21": {
    "class_type": "LTXVDualCFGGuider",
    "inputs": {
      "model": ["4", 0],
      "positive": ["8", 0],
      "negative": ["8", 1],
      "video_cfg": 1,
      "audio_cfg": 1
    }
  },
  "22": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["18", 0],
      "guider": ["21", 0],
      "sampler": ["19", 0],
      "sigmas": ["20", 0],
      "latent_image": ["17", 0]
    }
  },
  "23": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["22", 0] } },
  "24": {
    "class_type": "LatentUpscaleModelLoader",
    "inputs": { "model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors" }
  },
  "25": {
    "class_type": "LTXVLatentUpsampler",
    "inputs": { "samples": ["23", 0], "upscale_model": ["24", 0], "vae": ["9", 0] }
  },
  "26": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": ["9", 0],
      "image": ["3", 0],
      "latent": ["25", 0],
      "strength": 1,
      "bypass": false
    }
  },
  "27": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["26", 0], "audio_latent": ["23", 1] } },
  "28": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 } },
  "29": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler_ancestral" } },
  "30": { "class_type": "ManualSigmas", "inputs": { "sigmas": "0.85, 0.7250, 0.4219, 0.0" } },
  "31": {
    "class_type": "LTXVDualCFGGuider",
    "inputs": {
      "model": ["4", 0],
      "positive": ["8", 0],
      "negative": ["8", 1],
      "video_cfg": 1,
      "audio_cfg": 1
    }
  },
  "32": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["28", 0],
      "guider": ["31", 0],
      "sampler": ["29", 0],
      "sigmas": ["30", 0],
      "latent_image": ["27", 0]
    }
  },
  "33": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["32", 0] } },
  "34": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["33", 0],
      "vae": ["9", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 16
    }
  },
  "35": { "class_type": "LTXVAudioVAEDecode", "inputs": { "samples": ["33", 1], "audio_vae": ["10", 0] } },
  "36": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["34", 0],
      "fps": "$PARAM:framesPerSecond",
      "audio": ["35", 0],
      "bit_depth": 8
    }
  },
  "37": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["38", 0],
      "filename_prefix": "animated-series/ltx-final",
      "format": "auto",
      "format.codec": "auto"
    }
  },
  "38": {
    "class_type": "Video Slice",
    "inputs": {
      "video": ["36", 0],
      "start_time": 0,
      "duration": "$PARAM:durationSeconds",
      "strict_duration": true
    }
  }
}
