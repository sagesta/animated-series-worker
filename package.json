{
  "name": "animated-series-studio",
  "version": "0.8.0",
  "private": true,
  "description": "Local-first animated-series production studio with temporary cloud GPU workers",
  "main": "./out/main/index.js",
  "author": "Animated Series Studio",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "postinstall": "install-electron",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "quality": "pnpm docs:check && pnpm typecheck && pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:win": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
